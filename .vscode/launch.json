{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Start Dashboard Dev Server",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "${workspaceFolder}/dashboard",
      "console": "integratedTerminal"
    },
    {
      "name": "Run FlowKit Backend Server",
      "type": "python",
      "request": "launch",
      "module": "agent.main",
      "python": "D:\\python_envs\\flowkit\\python.exe",
      "cwd": "${workspaceFolder}",
      "env": {
        "GLA_RELOAD": "1"
      },
      "console": "integratedTerminal"
    }
  ]
}
