{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start FlowKit Server",
      "type": "shell",
      "command": "D:\\python_envs\\flowkit\\python.exe -m agent.main",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "GLA_RELOAD": "1"
        }
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Open FlowKit Console (TUI)",
      "type": "shell",
      "command": "D:\\python_envs\\flowkit\\python.exe scripts/launcher.py",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "focus": true
      }
    }
  ]
}
